pipeline {
	agent any

    tools {
		maven "jenkins-maven"
	}
	
	stages {
		stage('Checkout'){
		
			steps{
			
				git branch: 'main', url: 'https://github.com/lotlikarsahil/java-spring-boot-github-actions.git'
				
			}
		}
		
		stage('Build and Test'){
		
		    steps{
			
				sh 'mvn clean package'
			
			    sh 'mvn test'
			
			}
			
		}
	
	}
}