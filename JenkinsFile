pipeline {
	agent any

    tools {
		maven "jenkins-maven"
	}
	
	stages {
		stage('Checkout'){
		
			steps{
			
				git branch: 'main', url: 'https://github.com/lotlikarsahil/java-spring-boot-github-actions.git'
				
			}
		}
		
		stage('Build and Test'){
		
		    steps{
			
				sh 'mvn clean package'
			
			    sh 'mvn test'
			
			}
			
		}
		
		stage('Build and Push Docker Image'){
			environment{
			
				DOCKER_CREDS = credentials('docker-cred')
				IMAGE_TAG = "java-spring-boot-jenkins:${BUILD_NUMBER}"
			
			}
			steps{
				
				script{
					sh 'docker build -t ${DOCKER_CREDS_USR}/${IMAGE_TAG} .'
					
					def dockerImage = docker.image("${DOCKER_CREDS_USR}/${IMAGE_TAG}")
					
					docker.withRegistry('https://index.docker.io/v1/', "docker-cred") {
						dockerImage.push()
                    }
				}			
			}
		
		}
	
	}
}